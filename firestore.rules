rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Profiles: Users can read/write their own profile
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Events: 
    // - Planners can read/write all events created by them
    // - Clients can read events where their email matches the client_email field
    match /events/{eventId} {
       allow create: if isAuthenticated(); // Allow creation (mostly for planners)
       allow update, delete: if isAuthenticated() && (resource.data.planner_id == request.auth.uid || resource.data.client_email == request.auth.token.email);
       allow read: if isAuthenticated() && (resource.data.planner_id == request.auth.uid || resource.data.client_email == request.auth.token.email);
       
       // Subcollections (timeline, documents, payments)
       match /{subcollection}/{document=**} {
          allow read, write: if isAuthenticated(); 
       }
    }

    // Vendor bookings: a vendor assigned to a client's wedding.
    // - Planner (owner) can read/write
    // - Vendor (linked via vendor_uid) can read
    match /vendor_bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.planner_id == request.auth.uid ||
        resource.data.vendor_uid == request.auth.uid
      );
      allow create, update, delete: if isAuthenticated() && request.auth.uid == request.resource.data.planner_id;
    }

    // Pro documents (devis/factures prestataires).
    // - Planner can read/write all docs where planner_id matches
    // - Vendor can read docs where vendor_uid matches, and create docs with vendor_status 'submitted'
    match /pro_documents/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.planner_id == request.auth.uid ||
        resource.data.vendor_uid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.planner_id == request.auth.uid ||
        request.resource.data.vendor_uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.planner_id == request.auth.uid ||
        resource.data.vendor_uid == request.auth.uid
      );
    }

    // Vendor payments (acomptes couple -> prestataire).
    // - Planner can read/write (declares acomptes)
    // - Vendor can read only (consults echeancier)
    match /vendor_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.planner_id == request.auth.uid ||
        resource.data.vendor_uid == request.auth.uid
      );
      allow create, update, delete: if isAuthenticated() && request.auth.uid == request.resource.data.planner_id;
    }

    // Google OAuth tokens — accessible ONLY via Admin SDK (server-side)
    // Never expose refresh tokens to the client.
    match /google_tokens/{userId} {
      allow read, write: if false;
    }

    // Rate limits — accessible ONLY via Admin SDK (server-side)
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Settings — planner only (filtered by planner_id)
    match /settings/{docId} {
      allow read: if isAuthenticated() && resource.data.planner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.planner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.planner_id == request.auth.uid;
    }

    // Expenses — planner only (filtered by planner_id)
    match /expenses/{docId} {
      allow read: if isAuthenticated() && resource.data.planner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.planner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.planner_id == request.auth.uid;
    }

    // Notifications — only the recipient can read/update/delete their notifications
    // Any authenticated user can create (planner creates for client, client creates for planner, etc.)
    match /notifications/{docId} {
      allow read: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
    }

    // General fallback for other collections (clients, events, tasks, documents, devis, contracts,
    // invoices, galleries, compositions, conversations, messages, vendors, change_requests, agency, etc.)
    // Allows authenticated users to read/write. Tighten per-collection in production.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
